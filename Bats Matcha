    Dark = Color3.fromRGB(163, 73, 164),
    Text = Color3.fromRGB(163, 73, 164),
}

local _DrawingNew = Drawing.new
Drawing.new = function(kind)
    local obj = _DrawingNew(kind)

    pcall(function()
        if kind == "Square" then
            obj.Color = PurpleUI.Main
        elseif kind == "Line" or kind == "Triangle" or kind == "Circle" then
            obj.Color = PurpleUI.Accent
        elseif kind == "Text" then
            obj.Color = PurpleUI.Text
        end
    end)

    return obj
end

