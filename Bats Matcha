function buildEggLabels()
    for _, entry in pairs(S.eggLabelCache) do
        entry.label.Visible = false
        entry.dist.Visible  = false
    end
    S.eggLabels = {}
    local eggFolder = nil
    for _, child in pairs(game.Workspace:GetChildren()) do
        if child.Name == "" then eggFolder = child; break end
    end
    if not eggFolder then return end
    local seen = {}
    for _, egg in pairs(eggFolder:GetChildren()) do
        local part = nil
        if egg:IsA("BasePart") and egg.Name ~= "_PrimaryPart" then
            part = egg
        elseif egg:IsA("Model") then
            part = egg.PrimaryPart
            if not part then
                for _, p in pairs(egg:GetDescendants()) do
                    if p:IsA("BasePart") and p.Name ~= "_PrimaryPart" then part = p; break end
                end
            end
        end
        if not part then continue end
        local ok, pos = pcall(function() return part.Position end)
        if not ok or not pos or not pos.X then continue end
        local posKey = math.floor(pos.X/10).."_"..math.floor(pos.Y/10).."_"..math.floor(pos.Z/10)
        if seen[posKey] then continue end
        seen[posKey] = true
        local key = egg:GetFullName()
        if not S.eggLabelCache[key] then
            local label = Drawing.new("Text")
            label.Text="Easter Egg"; label.Position=Vector2.new(0,0)
            label.Color=Color3.fromRGB(255,105,180); label.Size=14
            label.Outline=true; label.Visible=false
            label.ZIndex=10; label.Font=Drawing.Fonts.Monospace; label.Center=true
